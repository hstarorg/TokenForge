# Optional RPC overrides. Leave empty to use bundled public RPCs.
# Override here if you have a paid endpoint (Alchemy / Infura / Helius / QuickNode).

# EVM (PublicNode default)
VITE_RPC_SEPOLIA=
VITE_RPC_BASE_SEPOLIA=
VITE_RPC_MAINNET=

# Solana (api.solana.com default; very rate-limited, prefer Helius/QuickNode)
VITE_RPC_SOLANA_DEVNET=
VITE_RPC_SOLANA_MAINNET=
